# Google Gemini API 키
# Google AI Studio (https://aistudio.google.com) 에서 발급
# 결제 수단(Billing)을 연결하지 않은 프로젝트 키만 사용할 것 (0원 원칙)
GEMINI_API_KEY=여기에_API_키_입력

# NeonDB 연결 문자열
# Vercel ↔ NeonDB 연동 시 자동 주입됩니다.
# 로컬 개발 시 NeonDB 대시보드 > Connection Details > .env 탭에서 복사
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
